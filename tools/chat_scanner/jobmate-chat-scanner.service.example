[Unit]
Description=JobMate private attachment scanner adapter
After=clamav-daemon.service
Requires=clamav-daemon.service

[Service]
User=jobmate-scanner
SupplementaryGroups=clamav
WorkingDirectory=/opt/jobmate/tools/chat_scanner
EnvironmentFile=/etc/jobmate-chat-scanner.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
